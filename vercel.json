  "rewrites": [
    { "source": "/connexion", "destination": "/connexion.html" },
    { "source": "/inscription", "destination": "/inscription.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/approche", "destination": "/approche.html" },
    { "source": "/offres", "destination": "/offres.html" },
    { "source": "/questionnaire", "destination": "/questionnaire.html" },
    { "source": "/mentions-legales", "destination": "/mentions-legales.html" },
    { "source": "/confidentialite", "destination": "/confidentialite.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/paiement", "destination": "/paiement.html" },
    { "source": "/experience", "destination": "/experience.html" },
    { "source": "/articles/pourquoi-je-reagis-plus-fort-que-la-situation-ne-le-merite", "destination": "/pourquoi-je-reagis-plus-fort-que-la-situation-ne-le-merite.html" },
    { "source": "/articles", "destination": "/articles.html" },
    { "source": "/introspection", "destination": "/introspection.html" },

{
  "version": 2,
  "name": "bee-congruence",
  "alias": [
    "www.beecongruence.com",
    "beecongruence.com"
  ],
  "framework": null,
  "buildCommand": null,
  "outputDirectory": null,
  "cleanUrls": true,
